generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique @db.VarChar(255)
  passwordHash String?             @map("password_hash") @db.VarChar(255)
  displayName  String              @map("display_name") @db.VarChar(255)
  avatarUrl    String?             @map("avatar_url") @db.Text
  googleId     String?             @unique @map("google_id") @db.VarChar(255)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  memberships   AccountMembership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Account {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @db.VarChar(100)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  memberships AccountMembership[]
  invitations AccountInvitation[]
  categories  Category[]
  creditCards CreditCard[]
  invoices    Invoice[]

  @@map("accounts")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  name      String       @db.VarChar(40)
  type      CategoryType @default(EXPENSE)
  color     String       @db.VarChar(7)
  icon      String       @db.VarChar(50)
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name], name: "uq_categories_account_name")
  @@index([accountId, type], name: "ix_categories_account_type")
  @@map("categories")
}

model AccountMembership {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId], name: "uq_memberships_user_account")
  @@index([userId], name: "ix_memberships_user_id")
  @@map("account_memberships")
}

model AccountInvitation {
  id        String           @id @default(uuid()) @db.Uuid
  accountId String           @map("account_id") @db.Uuid
  email     String           @db.VarChar(255)
  role      Role             @default(MEMBER)
  status    InvitationStatus @default(PENDING)
  token     String           @unique @db.VarChar(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz()
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([email, status], name: "ix_invitations_email_status")
  @@map("account_invitations")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], name: "ix_refresh_tokens_hash")
  @@map("refresh_tokens")
}

model CreditCard {
  id          String      @id @default(uuid()) @db.Uuid
  accountId   String      @map("account_id") @db.Uuid
  nickname    String      @db.VarChar(30)
  brand       CardBrand
  creditLimit Decimal     @map("credit_limit") @db.Decimal(12, 2)
  closingDay  Int         @map("closing_day")
  dueDay      Int         @map("due_day")
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoices    Invoice[]

  @@unique([accountId, nickname], name: "uq_credit_cards_account_nickname")
  @@index([accountId], name: "ix_credit_cards_account_id")
  @@map("credit_cards")
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  accountId    String        @map("account_id") @db.Uuid
  cardId       String        @map("card_id") @db.Uuid
  billingMonth Int           @map("billing_month")
  billingYear  Int           @map("billing_year")
  closingDate  DateTime      @map("closing_date") @db.Timestamptz()
  dueDate      DateTime      @map("due_date") @db.Timestamptz()
  totalAmount  Decimal       @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status       InvoiceStatus @default(OPEN)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz()
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card         CreditCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, billingYear, billingMonth], name: "uq_invoices_card_year_month")
  @@index([accountId, status], name: "ix_invoices_account_status")
  @@index([cardId, status], name: "ix_invoices_card_status")
  @@map("invoices")
}
