generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  PIX
}

enum PaymentStatus {
  PENDING
  PAID
}

enum RecurrenceFrequency {
  MONTHLY
}

enum IncomeStatus {
  RECEIVED
  PENDING
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique @db.VarChar(255)
  passwordHash String?             @map("password_hash") @db.VarChar(255)
  displayName  String              @map("display_name") @db.VarChar(255)
  avatarUrl    String?             @map("avatar_url") @db.Text
  googleId     String?             @unique @map("google_id") @db.VarChar(255)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  memberships   AccountMembership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Account {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @db.VarChar(100)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  memberships AccountMembership[]
  invitations AccountInvitation[]
  categories      Category[]
  creditCards     CreditCard[]
  invoices        Invoice[]
  expenses              Expense[]
  recurrenceRules       RecurrenceRule[]
  incomes               Income[]
  incomeRecurrenceRules IncomeRecurrenceRule[]

  @@map("accounts")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  name      String       @db.VarChar(40)
  type      CategoryType @default(EXPENSE)
  color     String       @db.VarChar(7)
  icon      String       @db.VarChar(50)
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expenses              Expense[]
  recurrenceRules       RecurrenceRule[]
  incomes               Income[]
  incomeRecurrenceRules IncomeRecurrenceRule[]

  @@unique([accountId, name], name: "uq_categories_account_name")
  @@index([accountId, type], name: "ix_categories_account_type")
  @@map("categories")
}

model AccountMembership {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId], name: "uq_memberships_user_account")
  @@index([userId], name: "ix_memberships_user_id")
  @@map("account_memberships")
}

model AccountInvitation {
  id        String           @id @default(uuid()) @db.Uuid
  accountId String           @map("account_id") @db.Uuid
  email     String           @db.VarChar(255)
  role      Role             @default(MEMBER)
  status    InvitationStatus @default(PENDING)
  token     String           @unique @db.VarChar(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz()
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([email, status], name: "ix_invitations_email_status")
  @@map("account_invitations")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], name: "ix_refresh_tokens_hash")
  @@map("refresh_tokens")
}

model CreditCard {
  id          String      @id @default(uuid()) @db.Uuid
  accountId   String      @map("account_id") @db.Uuid
  nickname    String      @db.VarChar(30)
  brand       CardBrand
  creditLimit Decimal     @map("credit_limit") @db.Decimal(12, 2)
  closingDay  Int         @map("closing_day")
  dueDay      Int         @map("due_day")
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  expenses        Expense[]
  recurrenceRules RecurrenceRule[]

  @@unique([accountId, nickname], name: "uq_credit_cards_account_nickname")
  @@index([accountId], name: "ix_credit_cards_account_id")
  @@map("credit_cards")
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  accountId    String        @map("account_id") @db.Uuid
  cardId       String        @map("card_id") @db.Uuid
  billingMonth Int           @map("billing_month")
  billingYear  Int           @map("billing_year")
  closingDate  DateTime      @map("closing_date") @db.Timestamptz()
  dueDate      DateTime      @map("due_date") @db.Timestamptz()
  totalAmount  Decimal       @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status       InvoiceStatus @default(OPEN)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz()
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card         CreditCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([cardId, billingYear, billingMonth], name: "uq_invoices_card_year_month")
  @@index([accountId, status], name: "ix_invoices_account_status")
  @@index([cardId, status], name: "ix_invoices_card_status")
  @@map("invoices")
}

model RecurrenceRule {
  id            String              @id @default(uuid()) @db.Uuid
  accountId     String              @map("account_id") @db.Uuid
  description   String              @db.VarChar(100)
  amount        Decimal             @db.Decimal(12, 2)
  frequency     RecurrenceFrequency @default(MONTHLY)
  dayOfMonth    Int                 @map("day_of_month")
  startDate     DateTime            @map("start_date") @db.Timestamptz()
  endDate       DateTime?           @map("end_date") @db.Timestamptz()
  paymentMethod PaymentMethod       @map("payment_method")
  categoryId    String              @map("category_id") @db.Uuid
  cardId        String?             @map("card_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  card          CreditCard?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  expenses      Expense[]

  @@index([accountId], name: "ix_recurrence_rules_account_id")
  @@map("recurrence_rules")
}

model Expense {
  id                 String          @id @default(uuid()) @db.Uuid
  accountId          String          @map("account_id") @db.Uuid
  description           String          @db.VarChar(100)
  descriptionNormalized String          @default("") @map("description_normalized") @db.VarChar(100)
  amount                Decimal         @db.Decimal(12, 2)
  transactionDate       DateTime        @map("transaction_date") @db.Timestamptz()
  dueDate               DateTime        @map("due_date") @db.Timestamptz()
  paymentMethod         PaymentMethod   @map("payment_method")
  paymentStatus         PaymentStatus   @default(PENDING) @map("payment_status")
  paidAt                DateTime?       @map("paid_at") @db.Timestamptz()
  categoryId            String          @map("category_id") @db.Uuid
  cardId                String?         @map("card_id") @db.Uuid
  invoiceId             String?         @map("invoice_id") @db.Uuid
  installmentGroupId    String?         @map("installment_group_id") @db.Uuid
  installmentNumber     Int?            @map("installment_number")
  installmentTotal      Int?            @map("installment_total")
  isRecurring           Boolean         @default(false) @map("is_recurring")
  recurrenceRuleId      String?         @map("recurrence_rule_id") @db.Uuid
  notes                 String?         @db.VarChar(255)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  account               Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category              Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  card                  CreditCard?     @relation(fields: [cardId], references: [id], onDelete: Restrict)
  invoice               Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recurrenceRule        RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)

  @@index([accountId, transactionDate], name: "ix_expenses_account_date")
  @@index([accountId, paymentMethod], name: "ix_expenses_account_method")
  @@index([accountId, paymentStatus], name: "ix_expenses_account_status")
  @@index([accountId, paidAt], name: "ix_expenses_account_paid_at")
  @@index([accountId, descriptionNormalized], name: "ix_expenses_account_description_normalized")
  @@index([invoiceId], name: "ix_expenses_invoice_id")
  @@index([installmentGroupId], name: "ix_expenses_installment_group")
  @@index([recurrenceRuleId], name: "ix_expenses_recurrence_rule")
  @@map("expenses")
}

model IncomeRecurrenceRule {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  description String    @db.VarChar(100)
  amount      Decimal   @db.Decimal(12, 2)
  dayOfMonth  Int       @map("day_of_month")
  startDate   DateTime  @map("start_date") @db.Timestamptz()
  endDate     DateTime? @map("end_date") @db.Timestamptz()
  categoryId  String    @map("category_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  incomes  Income[]

  @@index([accountId], name: "ix_income_recurrence_rules_account")
  @@map("income_recurrence_rules")
}

model Income {
  id                     String                @id @default(uuid()) @db.Uuid
  accountId              String                @map("account_id") @db.Uuid
  description            String                @db.VarChar(100)
  amount                 Decimal               @db.Decimal(12, 2)
  receiptDate            DateTime              @map("receipt_date") @db.Timestamptz()
  status                 IncomeStatus          @default(PENDING)
  categoryId             String                @map("category_id") @db.Uuid
  isRecurring            Boolean               @default(false) @map("is_recurring")
  incomeRecurrenceRuleId String?               @map("income_recurrence_rule_id") @db.Uuid
  notes                  String?               @db.Text
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz()

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  incomeRecurrenceRule IncomeRecurrenceRule? @relation(fields: [incomeRecurrenceRuleId], references: [id], onDelete: SetNull)

  @@index([accountId], name: "ix_incomes_account_id")
  @@index([accountId, receiptDate], name: "ix_incomes_account_receipt_date")
  @@index([categoryId], name: "ix_incomes_category_id")
  @@index([accountId, status], name: "ix_incomes_status")
  @@index([incomeRecurrenceRuleId], name: "ix_incomes_recurrence_rule_id")
  @@map("incomes")
}
