# =================================================================
# Configurações de Produção - Nova Versão (V2)
# =================================================================

# --- 1. Rede Compartilhada Traefik / PostgreSQL ---
# Nome da rede docker criada pelo outro repositório/compose.
# Verifique no servidor com: docker network ls (ex: "internal_net" ou "financial_internal_net")
EXTERNAL_NETWORK=internal_net

# --- 2. Domínios no Traefik (Versão V2 em Paralelo) ---
# Novos subdomínios/domínios para acessar a nova aplicação
NEW_WEB_DOMAIN=v2.seudominio.com.br
NEW_API_DOMAIN=v2-api.seudominio.com.br

# Nome do resolver ACME configurado no Traefik (padrão do docker-compose-bk.yaml é "myresolver")
TRAEFIK_CERT_RESOLVER=myresolver

# --- 3. Banco de Dados (Mesma Instância do PostgreSQL Existente) ---
# Hostname do container Postgres da versão anterior na mesma rede
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432

# Credenciais existentes na instância do PostgreSQL (as mesmas do .env do compose antigo)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mesma_senha_do_postgres_antigo

# Nome do NOVO database dedicado para a V2
# NOTA: Crie o database uma única vez no container existente antes de subir:
# docker exec -it postgresql psql -U postgres -c "CREATE DATABASE financial_v2_db;"
POSTGRES_DB=financial_v2_db

# --- 4. Autenticação & JWT ---
JWT_ACCESS_SECRET=gere_uma_chave_secreta_jwt_longa_e_forte_para_access_token_12345
JWT_REFRESH_SECRET=gere_uma_chave_secreta_jwt_longa_e_forte_para_refresh_token_abcde

# --- 5. Google OAuth 2.0 (Opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 6. Backup Automático do Novo Banco (V2) ---
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_DATA_PATH=./backups_v2
